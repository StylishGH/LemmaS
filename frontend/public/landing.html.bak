<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MathAI - Plataforma Cognitiva de Matematica</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f;
      --bg-subtle: #13111f;
      --card: rgba(19, 17, 28, 0.94);
      --border: rgba(124, 58, 237, 0.35);
      --accent-purple: #7c3aed;
      --accent-gold: #fbbf24;
      --text: #f8fafc;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    .hero { position: relative; width: 100%; height: 100vh; min-height: 600px; overflow: hidden; }
    .ken-burns { position: absolute; width: 100%; height: 100%; background-size: cover; background-position: center; background-repeat: no-repeat; animation: ken-burns-zoom 20s ease-in-out infinite; will-change: transform; }
    .layer-1 { background-image: url('/images/board-blue.jpeg'); z-index: 1; opacity: 0.6; filter: grayscale(30%) brightness(0.9); }
    .layer-2 { background-image: url('/images/board-green.jpeg'); z-index: 2; opacity: 0.4; filter: grayscale(50%) brightness(0.8); animation-delay: 5s; }
    @keyframes ken-burns-zoom { 0% { transform: scale(1) translate(0); } 30% { transform: scale(1.1) translate(-5%, -5%); } 60% { transform: scale(1.2) translate(2%, 3%); } 80% { transform: scale(1.15) translate(-3%, 2%); } 100% { transform: scale(1) translate(0); } }
    @media (prefers-reduced-motion: reduce) { .ken-burns { animation: none; transform: scale(1); } @keyframes ken-burns-zoom { 0% { transform: scale(1); } 100% { transform: scale(1.05); } } }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,15,0.8) 0%, rgba(19,17,31,0.9) 100%); pointer-events: none; }
    .hero-content { position: relative; z-index: 10; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 2rem; }
    .logo-text { font-size: clamp(2.5rem, 8vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; background: linear-gradient(135deg, #f8fafc 0%, #7c3aed 50%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 1rem; }
    .tagline { font-size: clamp(1rem, 3vw, 1.25rem); color: var(--text-muted); margin-bottom: 2rem; max-width: 600px; line-height: 1.6; }
    .cta-btn { display: inline-block; padding: 1rem 2rem; border-radius: 0.5rem; font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; min-width: 180px; }
    .cta-btn-primary { background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); color: white; box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4); }
    .cta-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(124, 58, 237, 0.5); }
    .cta-btn-secondary { background: var(--card); color: var(--text); border: 1px solid var(--border); margin-left: 1rem; }
    .cta-btn-secondary:hover { border-color: var(--accent-purple); background: rgba(124, 58, 237, 0.2); }
    .features { padding: 6rem 2rem; max-width: 1200px; margin: 0 auto; }
    .section-header { text-align: center; margin-bottom: 4rem; }
    .section-header h2 { font-size: 2rem; font-weight: 600; margin-bottom: 1rem; background: linear-gradient(135deg, #f8fafc 0%, #7c3aed 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .section-header p { color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; max-width: 1200px; margin: 0 auto; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 1rem; padding: 2rem; transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); border-color: var(--accent-purple); }
    .card h3 { font-size: 1.25rem; font-weight: 500; margin-bottom: 0.75rem; }
    .card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }
    .stats { padding: 4rem 2rem; background: var(--bg-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem; max-width: 1200px; margin: 0 auto; }
    .stat-item { text-align: center; }
    .stat-number { font-size: 2.5rem; font-weight: 700; background: linear-gradient(135deg, #7c3aed 0%, #fbbf24 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; margin-bottom: 0.5rem; }
    .stat-label { color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .nav-indicators { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.5rem; z-index: 20; }
    .nav-indicators span { width: 12px; height: 12px; border-radius: 50%; background: rgba(248,250,252,0.4); border: 2px solid var(--accent-purple); cursor: pointer; transition: background 0.2s, transform 0.2s; opacity: 0.5; }
    .nav-indicators span.active { background: var(--accent-purple); transform: scale(1.2); opacity: 1; }
    @media (max-width: 768px) { .hero { height: 500px; min-height: auto; } .hero-content { padding: 1.5rem; } .logo-text { font-size: 2rem; } .tagline { font-size: 1rem; } .cta-btn { width: 100%; margin: 0.5rem 0; } .cta-btn-secondary { margin-left: 0; margin-top: 0.5rem; } .nav-indicators { bottom: 1rem; } }
    @media (max-width: 480px) { .hero { height: 400px; min-height: auto; } .features { padding: 4rem 1rem; } .stat-number { font-size: 2rem; } }
  </style>
</head>
<body>

  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="ken-burns layer-1" aria-hidden="true"></div>
    <div class="ken-burns layer-2" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 class="logo-text">MathAI</h1>
      <p class="tagline">
        A IA que aprende como voce aprende Matematica para expandir seu raciocinio.
        Plataforma cognitiva adaptativa com diagnostico pedagogico e roteamento multimodal.
      </p>
      <div class="cta-buttons">
        <a href="/questoes" class="cta-btn cta-btn-primary"><span>Comecar a Resolver</span></a>
        <a href="/sobre" class="cta-btn cta-btn-secondary"><span>Conhecer a Plataforma</span></a>
      </div>
    </div>
    <div class="nav-indicators">
      <span class="active" data-slide="1"></span>
      <span data-slide="2"></span>
    </div>
  </section>

  <section class="features">
    <div class="section-header">
      <h2>Por que escolher o MathAI?</h2>
      <p>A plataforma que entende seu processo de aprendizado e se adapta ao seu ritmo.</p>
    </div>
    <div class="cards-grid">
      <div class="card"><h3>🧠 Diagnóstico Cognitivo</h3><p>Mapeia suas areas de force e oportunidades de melhoria atraves de analise de padrao de acertos.</p></div>
      <div class="card"><h3>📊 Roteamento Multimodal</h3><p>NVIDIA Nemotron para rigor formal + DeepSeek para intuicao heuristica, melhores insights lado a lado.</p></div>
      <div class="card"><h3>⏱️ Spaced Repetition SM-2</h3><p>Algoritmo de revisao otimizado que agenda revisoes no momento exato antes do esquecimento.</p></div>
      <div class="card"><h3>📱 Aprendizado Adaptativo</h3><p>Conteudo que se ajusta ao seu nivel, interesses e estilo de aprendizado em tempo real.</p></div>
    </div>
  </section>

  <section class="stats">
    <div class="stats-grid">
      <div class="stat-item"><div class="stat-number">288+</div><div class="stat-label">Questoes no Banco</div></div>
      <div class="stat-item"><div class="stat-number">87%</div><div class="stat-label">Taxa de Acerto Média</div></div>
      <div class="stat-item"><div class="stat-number">12</div><div class="stat-label">Matérias Cobertas</div></div>
      <div class="stat-item"><div class="stat-number">2s</div><div class="stat-label">Latencia Média</div></div>
    </div>
  </section>

  <footer class="bg-[#181528] border-t border-violet-900/30 py-6 text-sm">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-2 text-zinc-500"><span>📐</span><span>MathAI 2024</span></div>
        <div class="text-zinc-500"><a href="/questoes" class="hover:text-violet-400 transition">Questões</a><span>|</span><a href="/sobre" class="hover:text-violet-400 transition">Sobre</a></div>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var indicatorSpans = document.querySelectorAll('.nav-indicators span');
      var activeIndex = 0;
      function setActiveSlide(index) {
        indicatorSpans.forEach(function(span, i) { span.classList.toggle('active', i === index); });
      }
      setInterval(function() { activeIndex = (activeIndex + 1) % indicatorSpans.length; setActiveSlide(activeIndex); }, 7000);
      indicatorSpans.forEach(function(span, index) { span.addEventListener('click', function() { setActiveSlide(index); }); });
      var hero = document.querySelector('.hero');
      if (hero) { var layer1 = hero.querySelector('.layer-1'); var layer2 = hero.querySelector('.layer-2'); if (layer1 && layer2) { hero.addEventListener('mouseenter', function() { layer1.style.animationPlayState = 'paused'; layer2.style.animationPlayState = 'paused'; }); hero.addEventListener('mouseleave', function() { layer1.style.animationPlayState = 'running'; layer2.style.animationPlayState = 'running'; }); } }
    });
  </script>

</body>
</html>