# ==============================================================================
# MathAI - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Chaves de API e Variáveis de Ambiente (CRÍTICO: NUNCA SUBIR PRO GITHUB!)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
.streamlit/secrets.toml
cookies.txt
nul

# ------------------------------------------------------------------------------
# Ambientes Virtuais Python
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Bytecode, Cache e Compilação Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# Banco de Dados e Arquivos Temporários SQLite / Datasets Grandes
# ------------------------------------------------------------------------------
*.db-journal
*.db-wal
*.db-shm
data/mathai.db
*.parquet
data/*.parquet
data/uploads/mathnet_*

# ------------------------------------------------------------------------------
# Uploads e Arquivos de Usuários
# ------------------------------------------------------------------------------
data/uploads/resolucoes/*
!data/uploads/resolucoes/.gitkeep

# ------------------------------------------------------------------------------
# Scripts Temporários e Scratch de Desenvolvimento
# ------------------------------------------------------------------------------
scratch_*.py
temp_*
*.tmp
*.log
ver_usuarios.py
tmp/
Q17_output/

# ------------------------------------------------------------------------------
# IDEs, Editores de Código e Sistema Operacional
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Additions for Github Private Repo
*.sqlite3
data/*.db
.agents/

# Legacy web directory (superseded by frontend/)
web/
node_modules/
**/node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/

# SQL migration temporary dumps
data/migrate_questoes_chunk_*.sql
data/migrate_questoes_seq.sql
data/migrate_usuarios.sql

# CLI and local configs
config.json
skills-lock.json

# Scripts temporary dumps
scripts/*.txt
scripts/chatgpt_dump.json
scripts/chunk_*.sql
scripts/*.json

# Local directory junction for public images
frontend/public/data/
data/sources/
data/imagens/
graphify-out/
backend/graphify-out/
frontend/graphify-out/
.codex/
PROGRESS_REPORT.md

# Arquivos de Auditoria Temporária e Inventários de Imagens
military_image_inventory*
audit_military_images*.py
produce_final_inventory.py
compute_categories.py
extract_questions.py
download_*_exams.py
download_specific_missing.py
test_download_exams.py
execute_sql_corrected.py
test*.json
tests/benchmark_output/
data/audit/

# Integração Drive / OAuth Local
drive_*.py
token.json
client_secret*.json

# Relatórios temporários de scratch
*_SUMMARY.md
IMPLEMENTATION_AND_INSTRUCTIONS.md
RELATORIO*.md
RELATORIO_*.md

# Supabase CLI e SQL Temporários
supabase/.temp/
data/repertorio/temp_sql/

.vercel
.env*
